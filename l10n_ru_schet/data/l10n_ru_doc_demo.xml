            <field name="company_registry">1077847288397</field>
        </record>

        <record id="base.RUB" model="res.currency">
            <field name="active">1</field>
        </record>

        <record id="rub_pricelist" model="product.pricelist">
            <field name="name">Прайслист в рублях</field>
            <field name="currency_id" ref="base.RUB"/>
            <field name="discount_policy">with_discount</field>
        </record>

        <record id="base.main_company" model="res.company">
            <field name="external_report_layout_id" ref="web.external_layout_boxed"/>
